[Unit]
Description=bitdispatcher computer-aided dispatch
Documentation=https://github.com/BioDream-LLC/bitdispatcher
After=network-online.target
Wants=network-online.target

[Service]
User=bitdispatcher
Group=bitdispatcher
# The port and data folder are set in /etc/default/bitdispatcher; BITDISPATCHER_FLAGS adds options
# such as -tls-cert and -tls-key.
Environment=BITDISPATCHER_ADDR=:8443 BITDISPATCHER_DATA=/var/lib/bitdispatcher
EnvironmentFile=-/etc/default/bitdispatcher
ExecStart=/usr/bin/bitdispatcher -data ${BITDISPATCHER_DATA} -addr ${BITDISPATCHER_ADDR} $BITDISPATCHER_FLAGS
Restart=always
RestartSec=5
# A port below 1024, such as 443, needs this; nothing else is granted.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
# A data folder elsewhere also needs: sudo systemctl edit bitdispatcher, then [Service] ReadWritePaths=/that/folder
ReadWritePaths=/var/lib/bitdispatcher

[Install]
WantedBy=multi-user.target
